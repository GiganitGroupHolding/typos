FROM node:24-bookworm-slim
WORKDIR /app

COPY package.json package-lock.json ./
# Только зависимости запуска (tsx и sharp — в dependencies): сборщики и CLI вроде shadcn в образ не попадают.
RUN npm ci --omit=dev

COPY mcp ./mcp
COPY src ./src

ENV NODE_ENV=production
ENV MCP_AUTH_DATA_DIR=/data/auth
CMD ["node", "mcp/container.mjs"]

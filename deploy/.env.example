# Copy to deploy/.env and edit. Guide: docs/self-hosting.md

# Data outside the repository: storage/ (vault and keys), mcp/ (OAuth state), mcp.env (MCP secrets)
TYPOS_DATA=/srv/typos
VAULT_NAME=TYPOS

# --- Public domains ---
CADDYFILE=Caddyfile
APP_DOMAIN=app.example.com
VAULT_DOMAIN=vault.example.com
MCP_DOMAIN=mcp.example.com
VAULT_URL=https://vault.example.com
MCP_URL=https://mcp.example.com

# --- Local network without domains (comment out the block above) ---
# CADDYFILE=Caddyfile.lan
# LAN_IP=192.168.1.5
# VAULT_URL=https://192.168.1.5:8443
# MCP_URL=https://192.168.1.5:9443

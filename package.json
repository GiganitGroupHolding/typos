    "@fontsource/pt-serif": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.4",
    "@tiptap/extension-bubble-menu": "^3.31.4",

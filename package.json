{
  "name": "typos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-viewers.mjs",
    "dev": "vite",
    "prebuild": "node scripts/build-viewers.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "tsc -b && oxlint && prettier --check . && vitest run",
    "icons": "node scripts/gen-icons.mjs",
    "mcp": "tsx --tsconfig mcp/tsconfig.json mcp/server.ts",
    "viewers": "node scripts/build-viewers.mjs --force",
    "storage": "node server/typos-server.mjs",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "mcp:http": "tsx --tsconfig mcp/tsconfig.json mcp/httpServer.ts",
    "mcp:owner-key": "node scripts/mcp-owner-key.mjs"
  },
  "dependencies": {
